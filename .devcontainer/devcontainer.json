// Runs the demo in a GitHub codespace: a private Linux machine in the cloud,
// used from a browser. Nothing to install. See docs/DETAILS.md, "The web page".
{
  "name": "NoPorts demo",
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  // The demo is a set of Docker containers, so the codespace needs Docker.
  "features": { "ghcr.io/devcontainers/features/docker-in-docker:2": {} },
  // The demo's web page. A codespace's forwarded ports are private to you
  // unless you change them: leave this one private, because the page can run
  // commands in the demo's boxes.
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "NoPorts demo", "onAutoForward": "openBrowser" } },
  // Sets the demo up and starts the web page each time you open the codespace.
  "postAttachCommand": "./demo.sh web"
}
