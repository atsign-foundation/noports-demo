# Settings shared by compose.yaml and the scripts. Plain KEY=value only.
# The three atSigns the platform creates (listed in platform/atsigns).
CLIENT_ATSIGN=@demo_client
DEVICE_ATSIGN=@demo_device
RELAY_ATSIGN=@demo_relay
DEVICE_NAME=demo
# The platform's atDirectory name; containers resolve it via a network alias.
ROOT_SERVER=vip.ve.atsign.zone
# NoPorts release to build: "latest" (checked on each run when online), or a
# tag such as v5.18.2 to pin it.
NOPORTS_VERSION=latest
